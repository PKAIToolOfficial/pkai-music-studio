# ==========================================
# PKAI MUSIC STUDIO - ENVIRONMENT CONFIG
# ==========================================

# Application
NODE_ENV=production
APP_NAME=PKAI Music Studio
APP_URL=
FRONTEND_URL=
BACKEND_URL=

# ==========================================
# DATABASE - POSTGRESQL
# ==========================================

DATABASE_URL=

# ==========================================
# REDIS - BACKGROUND JOBS
# ==========================================

REDIS_URL=

# ==========================================
# SECURITY & AUTHENTICATION
# ==========================================

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TOKEN_EXPIRES=15m
JWT_REFRESH_TOKEN_EXPIRES=7d

ENCRYPTION_KEY=

# ==========================================
# GOOGLE AUTHENTICATION
# ==========================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ==========================================
# EMAIL VERIFICATION
# ==========================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ==========================================
# SMS VERIFICATION
# ==========================================

SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=

# ==========================================
# AI MUSIC GENERATION
# ==========================================

AI_MUSIC_PROVIDER=
AI_MUSIC_API_KEY=
AI_MUSIC_API_URL=

# ==========================================
# AI LYRICS & CHATBOT
# ==========================================

AI_TEXT_PROVIDER=
AI_TEXT_API_KEY=
AI_TEXT_API_URL=

# ==========================================
# AI IMAGE GENERATION
# ==========================================

AI_IMAGE_PROVIDER=
AI_IMAGE_API_KEY=
AI_IMAGE_API_URL=

# ==========================================
# AUDIO PROCESSING
# ==========================================

FFMPEG_PATH=/usr/bin/ffmpeg
MAX_AUDIO_UPLOAD_MB=500
MAX_TRACK_DURATION_SECONDS=1200

# ==========================================
# FILE STORAGE - S3 COMPATIBLE
# ==========================================

STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ==========================================
# CRYPTO PAYMENT VERIFICATION
# ==========================================

CRYPTO_NETWORK=
CRYPTO_RPC_URL=
CRYPTO_WALLET_ADDRESS=
CRYPTO_TOKEN_CONTRACT=
CRYPTO_CONFIRMATIONS_REQUIRED=12

# ==========================================
# PAYMENT WEBHOOK SECURITY
# ==========================================

PAYMENT_WEBHOOK_SECRET=

# ==========================================
# APPLICATION DEFAULT PRICING
# ==========================================

MONTHLY_PLAN_PRICE_USD=79
MONTHLY_PLAN_POINTS=2500

ANNUAL_PLAN_PRICE_USD=699
ANNUAL_PLAN_POINTS=36000

FREE_DAILY_POINTS=50

# ==========================================
# ADVERTISING CONFIGURATION
# ==========================================

ADMOB_APP_ID=
ADMOB_REWARDED_AD_UNIT_ID=
ADSENSE_CLIENT_ID=

# ==========================================
# MONITORING & ERROR TRACKING
# ==========================================

SENTRY_DSN=

# ==========================================
# PLATFORM CONFIGURATION
# ==========================================

DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ur,hi
ENABLE_RTL=true
